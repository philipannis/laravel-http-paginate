<?xml version="1.0" encoding="UTF-8"?>
<!-- Run package tests with strict output and warning checks. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <!-- Separate application integration tests from isolated parsing tests. -->
    <testsuites>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
    </testsuites>
    <!-- Limit package coverage reporting to runtime code. -->
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
    <!-- Keep tests independent of external caches and application logging. -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
    </php>
</phpunit>
